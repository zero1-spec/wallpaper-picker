<UserControl x:Class="WallPicker.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="False"
             SnapsToDevicePixels="False"
             MouseEnter="Card_MouseEnter"
             MouseLeave="Card_MouseLeave">
    <Grid x:Name="RootGrid" ClipToBounds="False">
        <!-- Glow in the wallpaper's own color, center card only (collapsed on side cards so the
             blur shader never runs for them). BitmapCache keeps the blurred result, so moving and
             scaling the card does not re-run the shader every frame. -->
        <Border x:Name="GlowBorder"
                Margin="12,28,12,-30"
                CornerRadius="28"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
            </Border.Effect>
            <Border.CacheMode>
                <BitmapCache RenderAtScale="0.5" EnableClearType="False" />
            </Border.CacheMode>
        </Border>

        <!-- One soft, blurred drop shadow (cached; replaces three hard-edged stacked rectangles). -->
        <Border x:Name="ShadowBorder"
                Margin="-2,10,-2,-16"
                CornerRadius="18"
                Background="#B4000000"
                IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="28" KernelType="Gaussian" RenderingBias="Performance" />
            </Border.Effect>
            <Border.CacheMode>
                <BitmapCache RenderAtScale="0.5" EnableClearType="False" />
            </Border.CacheMode>
        </Border>

        <!-- While a side card is lifted on hover, this pad keeps the spot it rose from hit-testable,
             so the card does not drop and re-lift (flicker) when the cursor is near its bottom edge. -->
        <Border x:Name="HoverPad"
                Background="Transparent"
                VerticalAlignment="Bottom"
                Height="24"
                Margin="0,0,0,-24"
                IsHitTestVisible="False" />

        <!-- Clipped rounded card body -->
        <Grid x:Name="ClipTarget" Background="#16161A">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ThumbRow" Height="200" />
                <RowDefinition x:Name="StripRow" Height="30" />
                <RowDefinition x:Name="FooterRow" Height="56" />
            </Grid.RowDefinitions>

            <!-- Thumbnail area (16:9, so typical wallpapers are shown uncropped) -->
            <Border Grid.Row="0" Background="#22222A">
                <Grid>
                    <Image x:Name="ThumbImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Rectangle x:Name="ShimmerRect"
                               Visibility="Collapsed"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="PlaceholderText"
                               Text="UNSUPPORTED"
                               Foreground="#787882"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Palette: one strip of 5 swatches. Hex codes only show on the center card. -->
            <Grid x:Name="StripGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Swatch0" Grid.Column="0" Background="#303036" Tag="0" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                    <TextBlock x:Name="Hex0" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Swatch1" Grid.Column="1" Background="#303036" Tag="1" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                    <TextBlock x:Name="Hex1" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Swatch2" Grid.Column="2" Background="#303036" Tag="2" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                    <TextBlock x:Name="Hex2" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Swatch3" Grid.Column="3" Background="#303036" Tag="3" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                    <TextBlock x:Name="Hex3" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Swatch4" Grid.Column="4" Background="#303036" Tag="4" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                    <TextBlock x:Name="Hex4" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#18181C" Padding="12,4,12,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Row="0"
                               Foreground="#F0F0F5"
                               FontFamily="Segoe UI, Arial"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MetaText"
                               Grid.Row="1"
                               Foreground="#9696A0"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Dimming overlay for side cards -->
            <Border x:Name="DimOverlay"
                    Grid.RowSpan="3"
                    Background="#78000000"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <!-- Center accent ring (brush = the selected wallpaper's accent color) -->
            <Border x:Name="AccentRing"
                    Grid.RowSpan="3"
                    CornerRadius="10"
                    BorderThickness="2"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <!-- Top-right // TAG badge -->
            <Border x:Name="TagBadge"
                    Grid.Row="0"
                    Height="20"
                    Padding="9,0"
                    CornerRadius="0,0,6,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,14,0"
                    Opacity="0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="TagText"
                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Top-left favorite heart badge -->
            <Border x:Name="FavBadge"
                    Grid.Row="0"
                    Width="22"
                    Height="22"
                    CornerRadius="11"
                    Background="#E1121216"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="7,7,0,0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock Text="&#x2665;"
                           Foreground="#FF6B8B"
                           FontFamily="Segoe UI, Arial"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-1,0,0" />
            </Border>

            <!-- Bottom-left "current" badge: this is the wallpaper on screen right now -->
            <Border x:Name="CurrentBadge"
                    Grid.Row="0"
                    Height="20"
                    CornerRadius="10"
                    Background="#E1121216"
                    Padding="7,0,9,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="7,0,0,7"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CurrentDot" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentText"
                               Text="CURRENT"
                               Foreground="#F0F0F5"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                               FontWeight="Bold"
                               FontSize="9"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
