<UserControl x:Class="WallPicker.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="False"
             SnapsToDevicePixels="False">
    <Grid x:Name="RootGrid" ClipToBounds="False">
        <!-- Lightweight layered shadow (hardware-accelerated, avoids expensive shader BlurEffect) -->
        <Border Margin="-8,0,-8,-16" CornerRadius="12" Background="#1A000000" IsHitTestVisible="False" />
        <Border Margin="-5,-3,-5,-13" CornerRadius="12" Background="#1A000000" IsHitTestVisible="False" />
        <Border Margin="-2,-6,-2,-10" CornerRadius="12" Background="#1A000000" IsHitTestVisible="False" />

        <!-- Clipped rounded card body -->
        <Grid x:Name="ClipTarget" Background="#16161A">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ThumbRow" Height="220" />
                <RowDefinition x:Name="PaletteRow0" Height="23" />
                <RowDefinition x:Name="PaletteRow1" Height="23" />
                <RowDefinition x:Name="PaletteRow2" Height="23" />
                <RowDefinition x:Name="PaletteRow3" Height="23" />
                <RowDefinition x:Name="PaletteRow4" Height="23" />
                <RowDefinition x:Name="FooterRow" Height="64" />
            </Grid.RowDefinitions>

            <!-- Thumbnail area -->
            <Border Grid.Row="0" Background="#282830">
                <Grid>
                    <Image x:Name="ThumbImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="PlaceholderText"
                               Text="UNSUPPORTED"
                               Foreground="#787882"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 5 Palette rows -->
            <Border x:Name="Swatch0" Grid.Row="1" Background="#303036" Tag="0" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock x:Name="Label0" Text="PRIMARY" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Hex0" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border x:Name="Swatch1" Grid.Row="2" Background="#303036" Tag="1" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock x:Name="Label1" Text="SECONDARY" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Hex1" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border x:Name="Swatch2" Grid.Row="3" Background="#303036" Tag="2" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock x:Name="Label2" Text="TERTIARY" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Hex2" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border x:Name="Swatch3" Grid.Row="4" Background="#303036" Tag="3" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock x:Name="Label3" Text="CONTAINER" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Hex3" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border x:Name="Swatch4" Grid.Row="5" Background="#303036" Tag="4" MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock x:Name="Label4" Text="SURFACE" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Hex4" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="6" Background="#18181C" Padding="12,4,12,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Row="0"
                               Foreground="#F0F0F5"
                               FontFamily="Segoe UI, Arial"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MetaText"
                               Grid.Row="1"
                               Foreground="#9696A0"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Dimming overlay for side cards -->
            <Border x:Name="DimOverlay"
                    Grid.RowSpan="7"
                    Background="#78000000"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <!-- Center accent ring -->
            <Border x:Name="AccentRing"
                    Grid.RowSpan="7"
                    CornerRadius="10"
                    BorderBrush="#5B8CFF"
                    BorderThickness="2"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <!-- Top-right // TAG badge -->
            <Border x:Name="TagBadge"
                    Grid.Row="0"
                    Background="#5B8CFF"
                    Height="20"
                    Padding="9,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,14,0"
                    Opacity="0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="TagText"
                           Foreground="#FFFFFF"
                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Top-left favorite heart badge -->
            <Border x:Name="FavBadge"
                    Grid.Row="0"
                    Width="22"
                    Height="22"
                    CornerRadius="11"
                    Background="#E1121216"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="7,7,0,0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock Text="&#x2665;"
                           Foreground="#FF6B8B"
                           FontFamily="Segoe UI, Arial"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-1,0,0" />
            </Border>
        </Grid>
    </Grid>
</UserControl>