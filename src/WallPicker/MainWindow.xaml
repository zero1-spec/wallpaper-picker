<Window x:Class="WallPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallPicker"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#0C0C10"
        Opacity="0"
        Focusable="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <Grid x:Name="RootGrid" Background="#0C0C10">
        <!-- Background layers: old image below, new image cross-fades in on top. -->
        <Image x:Name="BgOldImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False" />
        <Image x:Name="BgNewImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0"
               IsHitTestVisible="False" />

        <!-- Scrims: uniform darkening plus top/bottom gradients. The background itself is a
             blurred copy of the wallpaper (frosted glass), made on the background thread. -->
        <Rectangle Fill="#50000000" IsHitTestVisible="False" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#96000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.22" />
                    <GradientStop Color="#00000000" Offset="0.40" />
                    <GradientStop Color="#C8000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Arc carousel cards. CardView instances are added here in code. -->
        <Canvas x:Name="CardsCanvas" ClipToBounds="False" />

        <!-- Empty / scanning message. -->
        <TextBlock x:Name="EmptyText"
                   Text="Scanning..."
                   Foreground="#DCDCE6"
                   FontFamily="Segoe UI, Arial"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />

        <!-- Top action buttons. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="HeartButton"
                        Width="42"
                        Height="42"
                        CornerRadius="8"
                        Background="#222226"
                        Cursor="Hand"
                        MouseEnter="HeartButton_MouseEnter"
                        MouseLeave="HeartButton_MouseLeave"
                        MouseLeftButtonDown="HeartButton_MouseLeftButtonDown">
                    <TextBlock x:Name="HeartGlyph"
                               Text="&#x2665;"
                               Foreground="#AAAAB4"
                               FontFamily="Segoe UI, Arial"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border x:Name="SetButton"
                        Width="190"
                        Height="42"
                        Margin="8,0,0,0"
                        CornerRadius="8"
                        Background="#28282C"
                        Cursor="Hand"
                        MouseEnter="SetButton_MouseEnter"
                        MouseLeave="SetButton_MouseLeave"
                        MouseLeftButtonDown="SetButton_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Set wallpaper"
                                   Foreground="#F0F0F5"
                                   FontFamily="Segoe UI, Arial"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="18,0,50,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                        <Border Width="26"
                                Height="22"
                                CornerRadius="4"
                                BorderBrush="#787882"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                            <TextBlock Text="&#x21B5;"
                                       Foreground="#BEBEC8"
                                       FontFamily="Segoe UI, Arial"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Search overlay (hidden until "/" is pressed). -->
        <Border x:Name="SearchHost"
                Width="320"
                Height="40"
                Margin="30,28,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EB1E1E22"
                BorderBrush="#AA5B8CFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,0"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <Grid>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="search..."
                           Foreground="#7A7A88"
                           FontFamily="Segoe UI, Arial"
                           FontSize="15"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E6E6EE"
                         CaretBrush="#E6E6EE"
                         FontFamily="Segoe UI, Arial"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <!-- Collection overlay (C key): add/remove centered wallpaper to/from a collection. -->
        <Border x:Name="CollectionHost"
                Width="360"
                Height="40"
                Margin="30,78,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EB1E1E22"
                BorderBrush="#AA7C5BFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,0"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <Grid>
                <TextBlock x:Name="CollectionPlaceholder"
                           Text="collection name..."
                           Foreground="#7A7A88"
                           FontFamily="Segoe UI, Arial"
                           FontSize="15"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBox x:Name="CollectionBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E6E6EE"
                         CaretBrush="#E6E6EE"
                         FontFamily="Segoe UI, Arial"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         KeyDown="CollectionBox_KeyDown" />
            </Grid>
        </Border>

        <!-- Tag overlay (T key): comma-separated tags for centered wallpaper. -->
        <Border x:Name="TagHost"
                Width="360"
                Height="40"
                Margin="30,128,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EB1E1E22"
                BorderBrush="#AA5B8CFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,0"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <Grid>
                <TextBlock x:Name="TagPlaceholder"
                           Text="tags (comma separated)..."
                           Foreground="#7A7A88"
                           FontFamily="Segoe UI, Arial"
                           FontSize="15"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBox x:Name="TagBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E6E6EE"
                         CaretBrush="#E6E6EE"
                         FontFamily="Segoe UI, Arial"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         KeyDown="TagBox_KeyDown" />
            </Grid>
        </Border>

        <!-- Bottom bar: keycap hints (built in code) + frosted status pill. -->
        <Grid VerticalAlignment="Bottom" Margin="24,0,24,16" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="HintPanel"
                       Grid.Column="0"
                       Orientation="Horizontal"
                       VerticalAlignment="Bottom"
                       Margin="0,0,16,0" />
            <Border x:Name="StatusPill"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    CornerRadius="15"
                    Padding="14,6,16,6"
                    Background="#8C16161C"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="fill   &#x2022;   0 / 0"
                               Foreground="#E6FFFFFF"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast notification. -->
        <Border x:Name="ToastBorder"
                Background="#EB1E1E26"
                BorderBrush="#AA5B8CFF"
                BorderThickness="1"
                CornerRadius="20"
                Padding="24,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,100"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="20">
            <TextBlock x:Name="ToastText"
                       Foreground="#EBEBF5"
                       FontFamily="Segoe UI, Arial"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
