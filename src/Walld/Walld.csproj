<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>walld</AssemblyName>
    <RootNamespace>Walld</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>0.5.1</Version>
    <!-- Low-memory, low-CPU runtime settings (no concurrent/server GC, no tiered PGO). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperSuite.Core\WallpaperSuite.Core.csproj" />
    <!-- Build-order-only reference so wallpicker.exe lands next to walld.exe.
         The daemon never links against (or loads) the WPF picker assemblies. -->
    <ProjectReference Include="..\WallPicker\WallPicker.csproj" ReferenceOutputAssembly="false" />
    <!-- Build-order-only reference so wallvideo.exe lands next to walld.exe.
         The daemon never links against (or loads) the video player assemblies. -->
    <ProjectReference Include="..\WallVideo\WallVideo.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy the picker binaries next to the daemon so AppPaths.ResolveSibling finds them. -->
  <Target Name="CopyWallPickerNextToDaemon" AfterTargets="Build">
    <ItemGroup>
      <WallPickerOutput Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.exe" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.exe')" />
      <WallPickerOutput Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.dll" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.dll')" />
      <WallPickerOutput Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.deps.json" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.deps.json')" />
      <WallPickerOutput Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.runtimeconfig.json" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(WallPickerOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish -c Release must leave walld.exe + wallpicker.exe in one folder. -->
  <Target Name="CopyWallPickerToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WallPickerPublish Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.exe" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.exe')" />
      <WallPickerPublish Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.dll" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.dll')" />
      <WallPickerPublish Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.deps.json" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.deps.json')" />
      <WallPickerPublish Include="..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.runtimeconfig.json" Condition="Exists('..\WallPicker\bin\$(Configuration)\net8.0-windows\wallpicker.runtimeconfig.json')" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)" />
    <Copy SourceFiles="@(WallPickerPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy the video player binaries next to the daemon so AppPaths.ResolveSibling finds them. -->
  <Target Name="CopyWallVideoNextToDaemon" AfterTargets="Build">
    <ItemGroup>
      <WallVideoOutput Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.exe" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.exe')" />
      <WallVideoOutput Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.dll" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.dll')" />
      <WallVideoOutput Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.deps.json" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.deps.json')" />
      <WallVideoOutput Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.runtimeconfig.json" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(WallVideoOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish -c Release must leave walld.exe + wallvideo.exe in one folder. -->
  <Target Name="CopyWallVideoToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WallVideoPublish Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.exe" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.exe')" />
      <WallVideoPublish Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.dll" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.dll')" />
      <WallVideoPublish Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.deps.json" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.deps.json')" />
      <WallVideoPublish Include="..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.runtimeconfig.json" Condition="Exists('..\WallVideo\bin\$(Configuration)\net8.0-windows\wallvideo.runtimeconfig.json')" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)" />
    <Copy SourceFiles="@(WallVideoPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Built-in wallpapers (assets/wallpapers) ship next to the binaries in wallpapers\. -->
  <ItemGroup>
    <None Include="..\..\assets\wallpapers\**\*" Link="wallpapers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
